{
  "name": "opencode-brief",
  "version": "0.2.0",
  "description": "Create a reviewable handoff brief from an OpenCode session.",
  "license": "MIT",
  "author": "Mustafa Erpek",
  "keywords": ["opencode", "plugin", "handoff", "brief", "session"],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.tsx",
